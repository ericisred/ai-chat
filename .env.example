# ==========================================
# AI Chat 配置文件示例 (.env.example)
# 复制此文件为 .env 并填入真实的 API Key
# ==========================================

# 当前激活的大模型提供商: "deepseek" 或 "gemini"
LLM_PROVIDER=deepseek

# ------------------------------------------
# 滚动摘要记忆系统配置
# ------------------------------------------
# 触发摘要压缩的对话轮数阈值（默认 10 轮对话 / 20 条消息）
SUMMARY_TRIGGER_TURNS=10
# 压缩后原对话明细中保留最近的对话轮数（默认保留最近 5 轮对话 / 10 条消息）
RECENT_KEEP_TURNS=5

# ------------------------------------------
# DeepSeek 配置
# ------------------------------------------
# DeepSeek 开放平台 API Key (当 LLM_PROVIDER=deepseek 时必需)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DeepSeek API Base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 模型名称
DEEPSEEK_MODEL=deepseek-v4-flash

# ------------------------------------------
# Google Gemini 配置
# ------------------------------------------
# Google Gemini API Key (当 LLM_PROVIDER=gemini 时必需)
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini 模型名称
GEMINI_MODEL=gemini-3.6-flash
